# .env.example
# 请复制此文件为 .env 并填入真实信息

# ================= Telegram API 配置 (可选) =================
API_ID=
API_HASH=

# ================= Bot 配置 (必填) =================
BOT_TOKEN=

# ================= 代理配置 (可选) =================
# SOCKS5 代理，支持认证（用户名/密码）和无认证，默认 127.0.0.1:7897 (Clash 默认端口)
# 若不使用代理请留空
PROXY_HOST=127.0.0.1
PROXY_PORT=7897
PROXY_USER=
PROXY_PASS=

# ================= 系统运行配置 =================
# Web 服务运行端口 (默认 8011，如果端口冲突可随时更改)
PORT=8011
