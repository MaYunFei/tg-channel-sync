# .env.example
# 请复制此文件为 .env 并填入真实信息

# ================= Telegram API 配置 (可选) =================
API_ID=
API_HASH=

# ================= Bot 配置 (必填) =================
BOT_TOKEN=
# 自定义 Bot API 基础 URL（#3 解除机器人50MB限制），可选，例如：http://127.0.0.1:8081
BOT_API_BASE_URL=

# ================= 代理配置 (可选) =================
# SOCKS5 代理，支持用户名/密码认证；不使用代理请留空
PROXY_HOST=127.0.0.1
PROXY_PORT=7897
PROXY_USER=
PROXY_PASS=

# ================= 系统运行配置 =================
# Web 面板端口，默认 8011
PORT=8011
